@page "/request-appointment"
@inject BookDocApiClient Api
@inject PortalSessionState Session

<PageTitle>Request an Appointment | BOOKDOC2026</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Online Healthcare Portal</p>
        <h1>Request an Appointment</h1>
        <p>If you need an appointment outside published roster hours, require a specific specialty, or all slots are full, submit a request. Our clinic desk will review and confirm.</p>
    </div>
    <span class="badge badge-warning" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Requires Clinic Approval</span>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="banner error">
        @errorMessage
    </div>
}

<!-- Tab Navigation -->
<div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 2px solid #e2e8f0;">
    <button style="padding: 0.75rem 1.5rem; border: none; background: none; font-weight: 600; cursor: pointer; border-bottom: 3px solid @(activeTab == "submit" ? "#0284c7" : "transparent"); color: @(activeTab == "submit" ? "#0284c7" : "#64748b");"
            @onclick='() => activeTab = "submit"'>
        Submit New Request
    </button>
    <button style="padding: 0.75rem 1.5rem; border: none; background: none; font-weight: 600; cursor: pointer; border-bottom: 3px solid @(activeTab == "status" ? "#0284c7" : "transparent"); color: @(activeTab == "status" ? "#0284c7" : "#64748b");"
            @onclick='() => activeTab = "status"'>
        Check Request Status
    </button>
</div>

@if (activeTab == "submit")
{
    @if (submittedResponse != null)
    {
        <!-- Submission Success Card -->
        <section class="panel" style="max-width: 650px; margin: 2rem auto; text-align: center; border: 2px solid #f59e0b; background: #fffbeb; border-radius: 12px; padding: 2.5rem;">
            <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">⏳</div>
            <h2 style="color: #92400e; margin-bottom: 0.5rem;">Booking Request Submitted!</h2>
            <p style="color: #b45309; margin-bottom: 1.5rem;">Your request has reached the clinic reception desk and is pending approval.</p>

            <div style="background: white; border: 1px solid #fde68a; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; text-align: left; display: grid; gap: 0.75rem;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 0.5rem;">
                    <span style="color: #64748b;">Request Reference ID:</span>
                    <strong style="word-break: break-all;">@submittedResponse.Id</strong>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 0.5rem;">
                    <span style="color: #64748b;">Patient:</span>
                    <strong>@submittedResponse.PatientFullName</strong>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 0.5rem;">
                    <span style="color: #64748b;">Requested Date:</span>
                    <strong>@submittedResponse.PreferredDate.ToString("dd-MMM-yyyy") (@submittedResponse.PreferredTimeSlot)</strong>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 0.5rem;">
                    <span style="color: #64748b;">Preferred Doctor:</span>
                    <strong>@(submittedResponse.PreferredPractitionerName ?? "Any Available Doctor")</strong>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: #64748b;">Current Status:</span>
                    <span class="badge badge-warning">@submittedResponse.Status</span>
                </div>
            </div>

            <div style="display: flex; justify-content: center; gap: 1rem;">
                <button class="primary" @onclick='() => { trackedRequestId = submittedResponse.Id; activeTab = "status"; }'>Track This Request</button>
                <button class="secondary" @onclick="() => submittedResponse = null">Submit Another</button>
            </div>
        </section>
    }
    else
    {
        <!-- Submit Request Form -->
        <section class="panel" style="max-width: 720px; margin: 0 auto;">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Appointment Request</p>
                    <h2>Patient & Consultation Information</h2>
                </div>
            </div>

            <div class="form-grid">
                <label>
                    Clinic Branch ID *
                    <input @bind="branchId" placeholder="Enter branch ID..." />
                </label>

                <label>
                    Patient Full Name *
                    <input @bind="patientFullName" placeholder="e.g. Priya Patel" />
                </label>

                <label>
                    Phone Number *
                    <input type="tel" @bind="patientPhone" placeholder="e.g. +91 9876543210" />
                </label>

                <label>
                    Email Address (Optional)
                    <input type="email" @bind="patientEmail" placeholder="e.g. priya@example.com" />
                </label>

                <label>
                    Preferred Doctor (Optional)
                    <select @bind="selectedDoctorId">
                        <option value="">-- Any Available Doctor --</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.Id">@doc.DisplayName</option>
                        }
                    </select>
                </label>

                <label>
                    Preferred Date *
                    <input type="date" value="@preferredDate.ToString("yyyy-MM-dd")" @onchange="OnPreferredDateChanged" />
                </label>

                <label>
                    Preferred Time Window *
                    <select @bind="preferredTimeSlot">
                        <option value="Morning (09:00 AM - 12:00 PM)">Morning (09:00 AM - 12:00 PM)</option>
                        <option value="Afternoon (12:00 PM - 04:00 PM)">Afternoon (12:00 PM - 04:00 PM)</option>
                        <option value="Evening (04:00 PM - 08:00 PM)">Evening (04:00 PM - 08:00 PM)</option>
                        <option value="Anytime">Anytime during clinic hours</option>
                    </select>
                </label>
            </div>

            <div style="margin-top: 1rem;">
                <label style="font-weight: 600; display: block; margin-bottom: 0.5rem;">Reason for Consultation / Medical Notes *</label>
                <textarea rows="3" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.75rem;"
                          @bind="reasonForVisit"
                          placeholder="Please describe symptoms, purpose of visit, or previous consultation context..."></textarea>
            </div>

            <button class="primary" style="margin-top: 1.5rem; width: 100%; padding: 0.85rem;"
                    @onclick="SubmitBookingRequestAsync"
                    disabled="@(busy || string.IsNullOrWhiteSpace(branchId) || string.IsNullOrWhiteSpace(patientFullName) || string.IsNullOrWhiteSpace(patientPhone) || string.IsNullOrWhiteSpace(reasonForVisit))">
                @(busy ? "Submitting Request..." : "Submit Booking Request for Review")
            </button>
        </section>
    }
}
else
{
    <!-- Status Tracker Tab -->
    <section class="panel" style="max-width: 720px; margin: 0 auto;">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Status Lookup</p>
                <h2>Check Appointment Request Status</h2>
            </div>
        </div>

        <div class="form-grid" style="grid-template-columns: 2fr 1fr; align-items: flex-end;">
            <label>
                Request Reference ID
                <input @bind="trackedRequestId" placeholder="Paste Request ID here..." />
            </label>
            <button class="primary" @onclick="LookupStatusAsync" disabled="@(busy || string.IsNullOrWhiteSpace(trackedRequestId) || string.IsNullOrWhiteSpace(branchId))">
                @(busy ? "Checking..." : "Check Status")
            </button>
        </div>

        @if (lookupResult != null)
        {
            <div style="margin-top: 2rem; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem; background: #f8fafc;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem; margin-bottom: 1rem;">
                    <div>
                        <h3 style="margin: 0;">Request for @lookupResult.PatientFullName</h3>
                        <p style="margin: 0.25rem 0 0 0; color: #64748b; font-size: 0.85rem;">Date: @lookupResult.PreferredDate.ToString("dd-MMM-yyyy") (@lookupResult.PreferredTimeSlot)</p>
                    </div>
                    <span class="badge @GetBadgeClass(lookupResult.Status)" style="font-size: 1rem; padding: 0.4rem 0.8rem;">
                        @lookupResult.Status
                    </span>
                </div>

                <div style="display: grid; gap: 0.75rem;">
                    <div><strong>Doctor:</strong> @(lookupResult.AssignedPractitionerName ?? lookupResult.PreferredPractitionerName ?? "Clinic Assigned Doctor")</div>
                    <div><strong>Reason:</strong> @lookupResult.ReasonForVisit</div>
                    @if (!string.IsNullOrWhiteSpace(lookupResult.ReviewNotes))
                    {
                        <div style="background: white; border-left: 4px solid #0284c7; padding: 0.75rem; border-radius: 4px; margin-top: 0.5rem;">
                            <strong>Staff Instructions / Notice:</strong>
                            <p style="margin: 0.25rem 0 0 0; color: #334155;">@lookupResult.ReviewNotes</p>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
}

@code {
    private string activeTab = "submit";
    private string branchId = string.Empty;
    private string patientFullName = string.Empty;
    private string patientPhone = string.Empty;
    private string patientEmail = string.Empty;
    private string selectedDoctorId = string.Empty;
    private DateOnly preferredDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private string preferredTimeSlot = "Morning (09:00 AM - 12:00 PM)";
    private string reasonForVisit = string.Empty;

    private List<PractitionerSummaryResponse> doctors = new();
    private BookingRequestResponse? submittedResponse;
    private string trackedRequestId = string.Empty;
    private BookingRequestResponse? lookupResult;

    private string? errorMessage;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated && !string.IsNullOrWhiteSpace(Session.Session?.Scope?.BranchId))
        {
            branchId = Session.Session.Scope.BranchId;
            await LoadDoctorsAsync();
        }
    }

    private void OnPreferredDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
        {
            preferredDate = parsed;
        }
    }

    private async Task LoadDoctorsAsync()
    {
        if (string.IsNullOrWhiteSpace(branchId)) return;
        try
        {
            var roster = await Api.ListPractitionersAsync(branchId);
            doctors = roster.ToList();
        }
        catch { }
    }

    private async Task SubmitBookingRequestAsync()
    {
        if (string.IsNullOrWhiteSpace(branchId) || string.IsNullOrWhiteSpace(patientFullName) ||
            string.IsNullOrWhiteSpace(patientPhone) || string.IsNullOrWhiteSpace(reasonForVisit))
            return;

        busy = true;
        errorMessage = null;

        try
        {
            var request = new SubmitBookingRequest(
                BranchId: branchId,
                PatientId: null,
                PatientFullName: patientFullName.Trim(),
                PatientPhone: patientPhone.Trim(),
                PatientEmail: string.IsNullOrWhiteSpace(patientEmail) ? null : patientEmail.Trim(),
                PreferredPractitionerId: string.IsNullOrWhiteSpace(selectedDoctorId) ? null : selectedDoctorId,
                ServiceId: null,
                PreferredDate: preferredDate,
                PreferredTimeSlot: preferredTimeSlot,
                ReasonForVisit: reasonForVisit.Trim());

            submittedResponse = await Api.SubmitBookingRequestAsync(branchId, request);
        }
        catch (Exception ex)
        {
            errorMessage = $"Submission failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LookupStatusAsync()
    {
        if (string.IsNullOrWhiteSpace(branchId) || string.IsNullOrWhiteSpace(trackedRequestId)) return;
        busy = true;
        errorMessage = null;
        lookupResult = null;

        try
        {
            lookupResult = await Api.GetBookingRequestByIdAsync(branchId, trackedRequestId.Trim());
        }
        catch (Exception ex)
        {
            errorMessage = $"Lookup failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetBadgeClass(string status) => status switch
    {
        "PendingApproval" => "badge-warning",
        "UnderReview" => "badge-info",
        "Approved" => "badge-success",
        "Declined" => "badge-danger",
        "Rescheduled" => "badge-default",
        _ => "badge-default"
    };
}
