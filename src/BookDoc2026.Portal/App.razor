<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData"><RouteView RouteData="routeData" DefaultLayout="typeof(Layout.PortalLayout)" /><FocusOnNavigate RouteData="routeData" Selector="h1" /></Found>
    <NotFound><LayoutView Layout="typeof(Layout.PortalLayout)"><p>Page not found.</p></LayoutView></NotFound>
</Router>
