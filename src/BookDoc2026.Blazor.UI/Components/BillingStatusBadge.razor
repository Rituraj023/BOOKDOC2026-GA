<span class="billing-status @CssClass">@Status</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = string.Empty;

    private string CssClass => Status.Trim().ToLowerInvariant() switch
    {
        "paid" or "fullyallocated" => "settled",
        "partpaid" or "confirmed" => "partial",
        _ => "open"
    };
}
