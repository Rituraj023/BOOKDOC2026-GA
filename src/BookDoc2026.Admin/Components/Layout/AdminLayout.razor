@inherits LayoutComponentBase
@implements IDisposable
@inject AdminSessionState Session
@inject AuthApiClient Auth
@inject NavigationManager Navigation

<header class="topbar">
    <a class="brand" href="/">BOOKDOC2026 Admin</a>
    <nav>
        @if (Session.IsAuthenticated)
        {
            @if (CanAccessOpdReception)
            {
                <a href="/opd/reception">OPD Reception</a>
            }
            @if (CanAccessOpdTriage)
            {
                <a href="/opd/triage">Nurse Triage</a>
            }
            @if (CanAccessOpdDoctorConsultation)
            {
                <a href="/opd/doctor-consultation">Doctor OPD</a>
            }
            @if (CanManageDoctorSlots)
            {
                <a href="/scheduling/slots">Doctor Slots</a>
            }
            @if (CanReviewBookingRequests)
            {
                <a href="/scheduling/booking-requests">Booking Requests</a>
            }
            @if (CanViewCommunications)
            {
                <a href="/communications">Communications</a>
            }
            @if (CanManageQueueServicePoints)
            {
                <a href="/radiology/service-points">Radiology setup</a>
            }
            @if (CanAccessBilling)
            {
                <a href="/billing/oversight">Billing</a>
            }
        }
    </nav>
    <div class="session-nav">
        @if (Session.IsAuthenticated)
        {
            <span>@Session.Session!.DisplayName</span>
            <button @onclick="SignOutAsync">Sign out</button>
        }
        else
        {
            <a href="/login">Sign in</a>
        }
    </div>
</header>
<main class="shell">@Body</main>

@code {
    private bool CanAccessOpdReception => AdminPermissionPolicy.CanAccessOpdReception(Session.Permissions);
    private bool CanAccessOpdTriage => AdminPermissionPolicy.CanAccessOpdTriage(Session.Permissions);
    private bool CanAccessOpdDoctorConsultation => AdminPermissionPolicy.CanAccessOpdDoctorConsultation(Session.Permissions);
    private bool CanManageDoctorSlots => AdminPermissionPolicy.CanManageDoctorSlots(Session.Permissions);
    private bool CanReviewBookingRequests => AdminPermissionPolicy.CanReviewBookingRequests(Session.Permissions);
    private bool CanViewCommunications => AdminPermissionPolicy.CanAccessCommunications(Session.Permissions);
    private bool CanManageQueueServicePoints => AdminPermissionPolicy.CanManageQueueServicePoints(Session.Permissions);
    private bool CanAccessBilling => AdminPermissionPolicy.CanAccessBillingOversight(Session.Permissions);

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync(Auth);
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
