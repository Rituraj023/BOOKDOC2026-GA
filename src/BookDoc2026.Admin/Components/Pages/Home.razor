@page "/"

<h1>BOOKDOC2026 Admin</h1>
<ScopeBadge Label="Restricted ERP administration" />
<p>This network/IP-restricted host owns tenant approval, identity, roles, permissions, configuration, reporting, imports, exports and monitoring.</p>
@if (Session.IsAuthenticated)
{
    <p>Signed in as <strong>@Session.Session!.DisplayName</strong> with @(Session.Permissions.Count) permissions.</p>
    <PermissionDashboard Cards="Cards" Permissions="Session.Permissions" />
}
else
{
    <p><a class="primary-link" href="/login">Sign in to Admin</a></p>
}

@code {
    [Inject] private AdminSessionState Session { get; set; } = default!;
    private static readonly DashboardCardDescriptor[] Cards =
    [
        new("communications", "Communication management", "Templates, preferences, callbacks and delivery monitoring.", "/communications",
            RequiredAny: [FoundationPermissions.MessageTemplatesView, FoundationPermissions.MessageTemplatesManage,
                FoundationPermissions.MessageTemplatesPublish, FoundationPermissions.MessageDeliveriesView,
                FoundationPermissions.CommunicationPreferencesView, FoundationPermissions.CommunicationPreferencesManage,
                FoundationPermissions.ProviderCallbacksView], Badge: "Admin"),
        new("radiology-setup", "Radiology setup", "Configure X-ray and CT service points for an authorized branch.", "/radiology/service-points",
            [FoundationPermissions.QueuesServicePointsManage], Badge: "Configuration"),
        new("billing-oversight", "Billing oversight", "Review permission-approved recent invoices, payments, balances and immutable evidence.", "/billing/oversight",
            RequiredAny: [FoundationPermissions.BillingInvoicesView, FoundationPermissions.BillingPaymentsView], Badge: "Read only")
    ];
}
